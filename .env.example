# Root compose env (used by docker-compose.yml)

# Absolute path to your Firebase *service account* JSON.
# Example (Windows): C:\Users\Hp\Desktop\keys\firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=

# Optional: override exposed ports (compose currently binds 8000/8001 explicitly)
# GATEWAY_PORT=8000
# ML_PORT=8001

PORT=8000
SQLITE_PATH=./data/agrichain.db

# Optional. If set, Firebase auth is enabled for /v1 routes.
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Yield prediction service base URL.
# For local docker-compose this can remain empty (defaults to ML_BASE_URL).
YIELD_API_BASE_URL=http://127.0.0.1:8001

# Blockchain integration
# - mock (default): in-memory mock chain rules
# - bcs: Huawei Blockchain Cloud Service invoke gateway
BLOCKCHAIN_MODE=mock

# Huawei BCS invoke endpoint (HTTP). When set, the gateway will use the HTTP client.
# This is expected to be the full URL to your BCS chaincode invoke endpoint.
BCS_ENDPOINT=
BCS_ACCESS_KEY=
BCS_SECRET_KEY=

# Huawei Cloud SMS (Message & SMS service)
# Sign up at https://console.huaweicloud.com → Messaging → Message & SMS
# Create an SMS application to get APP_KEY and APP_SECRET
HUAWEI_SMS_APP_KEY=
HUAWEI_SMS_APP_SECRET=
# Channel/sender number from your SMS application
HUAWEI_SMS_SENDER=
# Template ID for notification messages (create in SMS console)
HUAWEI_SMS_TEMPLATE_ID=
# API endpoint (default: ap-southeast-1)
HUAWEI_SMS_API_URL=https://smsapi.ap-southeast-1.myhuaweicloud.com:443/sms/batchSendSms/v1
