# Huawei-specific environment variables (example)

HUAWEI_RPC_URL=https://your-huawei-rpc-endpoint

# Option 1: Use KMS (production recommended)
USE_KMS=false
HUAWEI_KMS_REGION=cn-north-4
HUAWEI_KMS_KEY_ID=your-kms-key-id
HUAWEI_ACCESS_KEY=your-huawei-access-key
HUAWEI_SECRET_KEY=your-huawei-secret-key

# Option 2: Use raw PRIVATE_KEY (development only)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_FOR_DEPLOY

# Backend
PORT=3000
ETHEREUM_RPC_URL=${HUAWEI_RPC_URL}
DATABASE_URL=./backend/data/database.sqlite

# Contract addresses (filled after deployment)
AGRI_YIELD_TOKEN_ADDRESS=
AGRI_ASSET_REGISTRY_ADDRESS=
AGRI_LOAN_MARKET_ADDRESS=
