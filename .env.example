# Root compose env (used by docker-compose.yml)

# Absolute path to your Firebase *service account* JSON.
# Example (Windows): C:\Users\Hp\Desktop\keys\firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=

# Optional: override exposed ports (compose currently binds 8000/8001 explicitly)
# GATEWAY_PORT=8000
# ML_PORT=8001
