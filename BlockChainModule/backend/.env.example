# Backend API Environment Configuration

# Ethereum Network Configuration
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_NETWORK=sepolia
CHAIN_ID=11155111

# Contract Addresses (after deployment)
AGRI_YIELD_TOKEN_ADDRESS=0x
AGRI_ASSET_REGISTRY_ADDRESS=0x
AGRI_LOAN_MARKET_ADDRESS=0x

# Backend Service Keys
BACKEND_PRIVATE_KEY=YOUR_BACKEND_WALLET_PRIVATE_KEY
BACKEND_WALLET_ADDRESS=YOUR_BACKEND_WALLET_ADDRESS
ORACLE_KEY=YOUR_ORACLE_API_KEY

# Database
DATABASE_URL=./data/agritech.db
DATABASE_BACKUP_PATH=./data/backups

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Security
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_GATEWAY=https://gateway.ipfs.io

# ML System Configuration
ML_PREDICTION_WEBHOOK_URL=http://your-ml-server:8000/api/predictions
ML_API_KEY=your_ml_api_key

# Harvest Oracle Configuration
HARVEST_ORACLE_URL=http://harvest-oracle-server:3001
HARVEST_ORACLE_KEY=your_oracle_key

# Feature Flags
ENABLE_LOCALHOST_TESTING=false
AUTO_REPAY_LOANS=false
LIQUIDATE_EXPIRED_LOANS=true

# Transaction Configuration
GAS_PRICE_MULTIPLIER=1.2
MAX_GAS_LIMIT=500000
TX_CONFIRMATION_BLOCKS=2
