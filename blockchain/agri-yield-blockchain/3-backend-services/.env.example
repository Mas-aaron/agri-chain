# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=agriyield

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# IPFS Configuration
IPFS_HOST=ipfs
IPFS_PORT=5001

# Huawei Cloud Configuration
HW_REGION=ap-southeast-1
BCS_INSTANCE_ID=your-bcs-instance-id
BCS_ACCESS_KEY=your-access-key
BCS_SECRET_KEY=your-secret-key
BCS_REST_API=https://your-bcs-rest-api

# Ethereum Configuration
ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
ETHEREUM_PRIVATE_KEY=your-private-key
ETHEREUM_CONTRACT_ADDRESS=0x...

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_PASSWORD=admin
GRAFANA_USER=admin

# Messaging
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ML Model
ML_MODEL_ENDPOINT=http://ml-service:5000/predict
ML_MODEL_VERSION=v2.1.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
JWT_SECRET=your-jwt-secret
API_KEY_LENGTH=32
CORS_ORIGINS=http://localhost:3000,https://farmers.agriyield.io

# Environment
ENVIRONMENT=development
