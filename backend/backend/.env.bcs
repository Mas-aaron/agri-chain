# AgriChain Backend — Fabric Gateway Environment
# Copy this to ECS at /root/agrichain.env
# These values come from your BCS SDK config (agri-chain-config.zip)

# ── Fabric Mode ──────────────────────────────────────────────
# Set to "gateway" to use real BCS Hyperledger Fabric
FABRIC_MODE=gateway

# ── Channel & Chaincode ──────────────────────────────────────
FABRIC_CHANNEL=yieldchannel
FABRIC_CHAINCODE=agriyeild

# ── Org: farmer-org (primary connecting org) ────────────────
# Peer endpoint reachable via BCS EIP on port 30605
FABRIC_PEER_ENDPOINT=176.52.136.255:30605
FABRIC_MSP_ID=4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8MSP

# ── TLS & Identity Certs (mounted at /certs inside container) ─
FABRIC_TLS_CERT_PATH=/certs/4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8.peer/msp/tlscacerts/tlsca.4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8-cert.pem
FABRIC_CERT_PATH=/certs/4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8.peer/msp/signcerts/User1@4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8.peer-4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8.default.svc.cluster.local-cert.pem
FABRIC_KEY_PATH=/certs/4fb93bc25f09757ebce82ba0f602c11c5d1cfcf8.peer/msp/keystore/6782ff17-f6d8-c826-0f61-62b04f3a56e4_sk

# ── Other orgs for reference (if you want multi-org later) ───
# exchange-org peer:  176.52.136.255:30610  MSP: 1a47c7406e8fe2c1d9493d35b9518b1a55ded47eMSP
# bank-org peer:      176.52.136.255:30615  MSP: d4ffc62a2a312d7efcadc3fa968f9c489493a4d2MSP
# orderer:            176.52.136.255:30805  (grpcs)
