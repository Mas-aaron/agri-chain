# AgriChain Flutter Production Environment Configuration

# Environment (development, staging, production)
FLUTTER_ENV=production

# API Configuration
API_BASE_URL=https://api.agrichain.com

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
CHAIN_ID=1

# Feature Flags
ENABLE_BLOCKCHAIN=true
ENABLE_DEBUG_LOGS=false

# Database Configuration (for local storage)
DATABASE_PATH=agrichain_prod.db
